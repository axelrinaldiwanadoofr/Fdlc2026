
# MultiViews enlevé sinon /page-personne/3 renvoie vers le fichier page-personne.page-xxx.js
Options -Indexes -MultiViews

# Les adresses de l'appli (/config, /plans/2...) ne sont pas des fichiers,
# on renvoie vers index.html et c'est Angular qui affiche la bonne page
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>

# index.html, main.js et styles.css gardent le meme nom a chaque build,
# le navigateur doit verifier s'ils ont change sinon il garde l'ancienne version du site
<IfModule mod_headers.c>
    <FilesMatch "(index\.html|main\.js|styles\.css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
