
# MultiViews enlevé sinon /page-personne/3 renvoie vers le fichier page-personne.page-xxx.js
Options -Indexes -MultiViews

# Les adresses de l'appli (/config, /plans/2...) ne sont pas des fichiers,
# on renvoie vers index.html et c'est Angular qui affiche la bonne page
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Fichiers qui ne doivent pas être servis (phpinfo, scripts sql, php dans les images)
    # et code source si ce fichier est lu dans src : on affiche l'appli à la place
    RewriteRule (^|/)phpinfo\.php$ index.html [L]
    RewriteRule \.sql$ index.html [L]
    RewriteRule ^assets/.*\.(php|phtml|phar)$ index.html [L]
    RewriteRule ^(app|components|services|modeles|sql|theme|environments)(/|$) index.html [L]
    RewriteRule \.(ts|scss)$ index.html [L]

    # Le site final est en https : on y renvoie si on arrive en http
    # (pas en local, et pas si un proxy devant le serveur fait déjà le https)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.|192\.168\.|10\.)
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]

    # dossier sans page d'accueil (assets, php/livre...) : l'appli plutôt que "Forbidden"
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_FILENAME}/index.html !-f
    RewriteCond %{REQUEST_FILENAME}/index.php !-f
    RewriteRule ^ index.html [L]
</IfModule>

# index.html, main.js et styles.css gardent le meme nom a chaque build,
# le navigateur doit verifier s'ils ont change sinon il garde l'ancienne version du site
<IfModule mod_headers.c>
    # Le site ne peut pas être affiché dans une iframe d'un autre site,
    # et le navigateur ne devine pas le type d'un fichier (photo envoyée qui contiendrait du html)
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"
    Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
    Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"

    <FilesMatch "(index\.html|main\.js|styles\.css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# En production les erreurs PHP ne sont pas affichées (noms de tables, chemins du serveur)
<IfModule mod_php.c>
    php_flag display_errors off
</IfModule>
