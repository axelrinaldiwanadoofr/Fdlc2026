# Seul le dossier www est publié : le reste du dépôt (.git, php, src, node_modules...)
# n'est pas accessible, on renvoie vers l'appli au lieu d'afficher une erreur
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^www(/|$) - [L]

    # %2 = chemin du dossier du projet sur le serveur (ex : /Fdlc2026/)
    RewriteCond $0#%{REQUEST_URI} ^([^#]*)#(.*)\1$
    RewriteRule ^.*$ %2www/ [R=302,L]
</IfModule>
